[Desktop Entry]
Version=1.0
Type=Application
Name=Google Chrome
Comment=Navegador web
Exec=/usr/bin/google-chrome-stable %U
Icon=google-chrome
Terminal=false
StartupNotify=true
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Categories=Network;WebBrowser;
